{
  "name": "networkbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicación de escritorio para medir el rendimiento de red usando NTTTCP",
  "license": "GPL-3.0-or-later",
  "author": "Daniel Diez Mardomingo",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "node scripts/test/coverage-rust.mjs",
    "test": "vitest run",
    "tauri": "tauri",
    "verify": "node scripts/verify-app.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-updater": "2.12.0",
    "loglevel": "1.9.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
