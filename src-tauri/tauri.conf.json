{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetworkBench",
  "version": "0.1.0",
  "identifier": "com.danimardo.networkbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetworkBench",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ntttcp"],
    "resources": [
      "resources/networkbench-firewall-helper.exe",
      "../engine/LICENSE",
      "../engine/VERSION",
      "../THIRD_PARTY_NOTICES.md",
      "../LICENSE"
    ],
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "nsis/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
