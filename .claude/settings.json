{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git remote -v)",
      "Bash(node scripts/agent/verify.mjs)",
      "Bash(node scripts/agent/check-agents-size.mjs)",
      "Bash(node scripts/agent/check-adapters.mjs)",
      "Bash(node scripts/agent/check-references.mjs)",
      "Bash(node scripts/agent/check-spec-history.mjs)",
      "Bash(node Design/scripts/verify-tokens.mjs)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(claude --version)",
      "Bash(codex --version)",
      "Bash(rustc --version)",
      "Bash(cargo --version)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(diff:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(cargo install:*)",
      "Bash(rustup:*)",
      "Edit(.specify/**)",
      "Edit(**/.specify/**)",
      "Edit(.agents/skills/speckit-*/**)",
      "Edit(**/.agents/skills/speckit-*/**)",
      "Edit(Design/**)",
      "Edit(**/Design/**)",
      "Edit(Historias.md)",
      "Edit(**/Historias.md)",
      "Edit(Especificacion.md)",
      "Edit(**/Especificacion.md)",
      "Edit(AUDITORIA_DISENO_V3.md)",
      "Edit(**/AUDITORIA_DISENO_V3.md)",
      "Edit(.logs/**)",
      "Edit(**/.logs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/guard-protected-paths.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
