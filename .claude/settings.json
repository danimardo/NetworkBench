{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git remote -v)",
      "Bash(node scripts/agent/verify.mjs)",
      "Bash(node scripts/agent/check-agents-size.mjs)",
      "Bash(node scripts/agent/check-adapters.mjs)",
      "Bash(node scripts/agent/check-references.mjs)",
      "Bash(node scripts/agent/check-spec-history.mjs)",
      "Bash(node Design/scripts/verify-tokens.mjs)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(claude --version)",
      "Bash(codex --version)",
      "Bash(rustc --version)",
      "Bash(cargo --version)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git ls-tree:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git worktree list)",
      "PowerShell(git remote -v)",
      "PowerShell(node scripts/agent/verify.mjs)",
      "PowerShell(node scripts/agent/check-agents-size.mjs)",
      "PowerShell(node scripts/agent/check-adapters.mjs)",
      "PowerShell(node scripts/agent/check-references.mjs)",
      "PowerShell(node scripts/agent/check-spec-history.mjs)",
      "PowerShell(node Design/scripts/verify-tokens.mjs)",
      "PowerShell(node --version)",
      "PowerShell(pnpm --version)",
      "PowerShell(claude --version)",
      "PowerShell(codex --version)",
      "PowerShell(rustc --version)",
      "PowerShell(cargo --version)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(Test-Path:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh release:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git reset:*)",
      "PowerShell(git revert:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git cherry-pick:*)",
      "PowerShell(gh pr:*)",
      "PowerShell(gh issue:*)",
      "PowerShell(gh release:*)",
      "Bash(nvm:*)",
      "PowerShell(nvm:*)",
      "Bash(pnpm install:*)",
      "PowerShell(pnpm install:*)",
      "Bash(cargo install:*)",
      "PowerShell(cargo install:*)",
      "Bash(pnpm audit:*)",
      "PowerShell(pnpm audit:*)",
      "Bash(cargo audit:*)",
      "PowerShell(cargo audit:*)",
      "Bash(specify integration:*)",
      "PowerShell(specify integration:*)",
      "Edit(.specify/memory/constitution.md)",
      "Edit(**/.specify/memory/constitution.md)"
    ],
    "deny": [
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(rustup:*)",
      "PowerShell(npm install:*)",
      "PowerShell(pnpm add:*)",
      "PowerShell(rustup:*)",
      "Edit(.specify/integrations/**)",
      "Edit(**/.specify/integrations/**)",
      "Edit(.specify/scripts/**)",
      "Edit(**/.specify/scripts/**)",
      "Edit(.specify/templates/**)",
      "Edit(**/.specify/templates/**)",
      "Edit(.specify/workflows/**)",
      "Edit(**/.specify/workflows/**)",
      "Edit(.specify/*.json)",
      "Edit(**/.specify/*.json)",
      "Edit(.agents/skills/speckit-*/**)",
      "Edit(**/.agents/skills/speckit-*/**)",
      "Edit(Design/**)",
      "Edit(**/Design/**)",
      "Edit(Especificacion.md)",
      "Edit(**/Especificacion.md)",
      "Edit(AUDITORIA_DISENO_V3.md)",
      "Edit(**/AUDITORIA_DISENO_V3.md)",
      "Edit(.logs/**)",
      "Edit(**/.logs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/guard-protected-paths.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
